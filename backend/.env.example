# DealSignal AI - Backend Environment Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Configuration (supports OpenAI, Groq, OpenRouter, Azure, or any OpenAI-compatible provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Set to true to force deterministic offline test mode (automatically active if no API key is provided)
TEST_MODE=false

# Persistence (SQLite by default)
DATABASE_URL=sqlite:///./dealsignal.db

# Security & Bounded Request Limits
REQUEST_TIMEOUT_SECONDS=10
MAX_RESPONSE_SIZE_BYTES=2097152
MAX_AGENT_ITERATIONS=3
