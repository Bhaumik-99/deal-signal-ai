# ==========================================
# DealSignal AI - Environment Configuration
# ==========================================

# --- Frontend Configuration ---
# Vite Proxy Target (Defaults to local FastAPI backend)
VITE_API_URL=http://127.0.0.1:8000

# --- Backend Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM Provider (Optional - fallback to offline parser if unset) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
TEST_MODE=false

# --- Real Email / SMTP Configuration ---
# You can also configure SMTP directly in the DealSignal AI web UI under "Email & SMTP Settings"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="DealSignal Growth Team"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
